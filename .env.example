# Required for Ethereum AML analysis
ALCHEMY_URL=

# Optional per-network Alchemy URLs
ALCHEMY_ETHEREUM_URL=
ALCHEMY_POLYGON_URL=
ALCHEMY_ARBITRUM_URL=
ALCHEMY_BASE_URL=
ALCHEMY_BSC_URL=

# OpenSanctions - required for real sanctions screening
OPENSANCTIONS_API_KEY=
OPENSANCTIONS_URL=https://api.opensanctions.org/match/default
OPENSANCTIONS_THRESHOLD=0.85

# Optional tuning
ALCHEMY_MAX_PAGES=10
ALCHEMY_PAGE_SIZE=100
ALCHEMY_TIMEOUT_MS=12000

# Token Scan / Assistant
ETHERSCAN_API_KEY=
OPENROUTER_API_KEY=

# Optional frontend restriction. If empty, API remains CORS-compatible with the existing app.
# FRONTEND_ORIGIN=https://encryptec.lovable.app
